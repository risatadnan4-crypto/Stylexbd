{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "dist/**",
        "../dist/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|uploads|assets|public|favicon.ico|index.html|vite.svg).*)$",
      "destination": "/api/index.ts"
    }
  ]
}
