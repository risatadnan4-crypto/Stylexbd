{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": ["dist/**", "data/**", "index.html"]
    }
  },
  "rewrites": [
    {
      "source": "/api/sitemap",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/:path*",
      "destination": "/api/index"
    }
  ]
}
